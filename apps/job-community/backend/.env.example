# Copy to .env and export variables in your shell; Spring does not load .env automatically.
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_key
# Optional: empty uses inline price_data for exactly EUR 99 cents.
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL='http://localhost:5175/payment/success?session_id={CHECKOUT_SESSION_ID}'
STRIPE_CANCEL_URL=http://localhost:5175/payment/cancel
COMMUNITY_FRONTEND_ORIGIN=http://localhost:5175
COMMUNITY_SEED_ENABLED=true
