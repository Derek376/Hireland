{
  "name": "hireland",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:seed": "node --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "node --conditions=react-server --test tests/*.test.ts",
    "check:m0": "node scripts/check-m0.mjs && npm run typecheck",
    "check:providers": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-providers.mjs",
    "check:m2": "node --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-m2.ts",
    "check:m3": "node --conditions=react-server --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-m3.ts"
  },
  "dependencies": {
    "mammoth": "1.11.0",
    "next": "16.4.0",
    "pdf-parse": "2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
