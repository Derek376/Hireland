# Copy to .env.local. Keep all values server-side; never use NEXT_PUBLIC_ for secrets.
APP_URL=http://localhost:3000
DATABASE_PATH=./data/hireland.sqlite
# No default model: choose and verify a structured-output model with your account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
STRIPE_SECRET_KEY=
# Set from the sandbox webhook / local event forwarding tool during M3.
STRIPE_WEBHOOK_SECRET=
# A sandbox Price for EUR 0.99, one-time purchase; not used by the M0 check.
STRIPE_TOPIC_PRICE_ID=
