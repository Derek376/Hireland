# Copy to .env.local. Keep all values server-side; never use NEXT_PUBLIC_ for secrets.
APP_URL=http://127.0.0.1:3000
DATABASE_PATH=./data/hireland.sqlite
# Tested example model; verify structured-output support with your account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
STRIPE_SECRET_KEY=
# Set from the sandbox webhook / local event forwarding tool during M3.
STRIPE_WEBHOOK_SECRET=
# Optional legacy variable, unused: M3 creates server-owned inline EUR 0.99 prices.
STRIPE_TOPIC_PRICE_ID=
